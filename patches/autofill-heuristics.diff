diff --git a/zathura/macos.h b/zathura/macos.h
new file mode 100644
index 00000000..e734e741
--- /dev/null
+++ b/zathura/macos.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: Zlib */
+
+#ifndef ZATHURA_MACOS_H
+#define ZATHURA_MACOS_H
+
+/**
+ * Apply macOS-specific workarounds. Must be called before gtk_init.
+ */
+void zathura_macos_init(void);
+
+#endif // ZATHURA_MACOS_H
diff --git a/zathura/macos.m b/zathura/macos.m
new file mode 100644
index 00000000..ebc60609
--- /dev/null
+++ b/zathura/macos.m
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: Zlib */
+
+#import <Foundation/Foundation.h>
+
+#include "macos.h"
+
+void zathura_macos_init(void) {
+  @autoreleasepool {
+    /* On macOS 26, AppKit's AutoFill heuristics repeatedly request the
+     * SafariPlatformSupport completion list view service for GDK's text input
+     * view. Loading it fails (NSXPCSharedListenerErrorDomain Code=2) and it is
+     * re-requested immediately, pinning the main thread and WindowServer. */
+    [[NSUserDefaults standardUserDefaults] registerDefaults:@{@"NSAutoFillHeuristicsEnabled" : @NO}];
+  }
+}
